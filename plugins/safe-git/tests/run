#!/usr/bin/env bash
# Run every tests/test_*.sh, then shellcheck. Lint failures are test failures.
set -uo pipefail
# shellcheck disable=SC2164 # dirname of the running script always exists.
cd "$(cd "$(dirname "$0")" && pwd)"

failed=0
total=0
for t in test_*.sh; do
  total=$((total + 1))
  printf '%s\n' "$t"
  bash "$t" || failed=$((failed + 1))
done

if command -v shellcheck >/dev/null 2>&1; then
  printf 'shellcheck\n'
  shellcheck -x test_*.sh helpers.sh run || failed=$((failed + 1))
else
  printf 'shellcheck: not installed, skipped\n'
fi

if [ "$failed" -gt 0 ]; then
  printf '\n%d check(s) FAILED\n' "$failed" >&2
  exit 1
fi
printf '\nall %d suites passed\n' "$total"
